# Patterns for build/packaging folders are anchored with a leading "/" so they
# only match at the repo root. The unanchored Python-template "lib/" used to
# match frontend/src/lib/, so new files there were silently never committed.

# ---------------- Secrets (never commit) ----------------
# Real env files. The committed templates are named env.example.txt, which
# none of these match.
.env
.env.*
*.env
credentials.json
.credentials
*.pem
*.key

# ---------------- Python ----------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
/build/
/dist/
/lib/
/lib64/
/wheels/
# Virtual environments
.venv/
venv/
/env/
# Tool caches and coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ---------------- Node / frontend ----------------
# (frontend/.gitignore also covers its own node_modules and build output)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------- Test & eval output ----------------
test_reports/
junit*.xml

# ---------------- Editors, OS, local tooling ----------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
.claude/settings.local.json
